# MySQL 8 (VPS)
DATABASE_URL=mysql://desy:password@127.0.0.1:3306/desy_nails

# Auth pannello admin (AUTH_SECRET firma anche i token anti-bot del form)
AUTH_SECRET=genera-una-stringa-lunga-casuale
ADMIN_PASSWORD=cambia-questa-password

# Email ordini / prenotazioni (Resend, dominio mittente verificato: bitora.it)
RESEND_API_KEY=
EMAIL_FROM=Desy Nails <prenotazioni@bitora.it>
STUDIO_EMAIL=tropini.desi06@gmail.com

# Google reCAPTCHA v3 (https://www.google.com/recaptcha/admin) — senza chiavi la verifica viene saltata
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# URL pubblico del sito (ICS, link nelle email)
APP_URL=https://desynails.bitora.it
